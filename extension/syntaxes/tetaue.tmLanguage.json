{
  "$schema": "https://raw.githubusercontent.com/martinring/tmgrammar-schema/master/schema.json",
  "name": "Tetaue",
  "scopeName": "source.tetaue",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "match": "#.*$", "name": "comment.line.number-sign.tetaue" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.tetaue",
          "patterns": [
            { "match": "\\\\.", "name": "constant.character.escape.tetaue" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "match": "\\b\\d+(\\.\\d+)?\\b", "name": "constant.numeric.tetaue" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(import|table|filter|map|sort|take|distinct|fold|joinInner|joinLeft|joinRight|joinFull|asc|desc|group|count|sum|avg|min|max|coalesce|fmap|replaceWith|ap|applyLeft|applyRight|orElse|bind|then|from_maybe|is_nothing|is_just|is_null|is_not_null|just|nothing|div|mod|upper|lower|length|abs|is_in|is_not_in|not|rename|pick|omit|true|false|null|query|maybe|forall|case|_)\\b",
          "name": "keyword.other.tetaue"
        },
        {
          "match": "\\b(int|float|decimal|string|bool|date|timestamp)\\b",
          "name": "storage.type.tetaue"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "_(?:>>>|<<<|>>=|>>|<\\$>|<\\$|<\\*>|<\\*|\\*>|<\\|>|==|!=|<=|>=|&&|\\|\\||\\+|-|\\*|/|<>|<|>|&|\\$|[A-Za-z][A-Za-z0-9_]*)_|&&|\\|\\||>>>|<<<|>>=|>>|<\\$>|<\\$|<\\*>|<\\*|\\*>|<\\|>|==|!=|<=|>=|=>|&|\\$|\\*|/|%|\\+|-|<|>",
          "name": "keyword.operator.tetaue"
        }
      ]
    }
  }
}
