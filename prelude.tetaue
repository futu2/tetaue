# The public language surface is ordinary source; only @ names are core.
# Scalar types are aliases for the reserved core type namespace.
export type int = @int
export type float = @float
export type decimal = @decimal
export type string = @string
export type bool = @bool
export type date = @date
export type timestamp = @timestamp

# Public SQL functions are ordinary aliases of the reserved core namespace.
export param = @param
export table = @table
export filter = @filter
export select = @select
export map = @map
export fold = @fold
export sort = @sort
export take = @take
export drop = @drop
export recursive = @recursive
export distinct = @distinct
export join_lateral = @join_lateral
export joinInner = @joinInner
export joinLeft = @joinLeft
export joinRight = @joinRight
export joinFull = @joinFull
export union = @union
export union_all = @union_all
export intersect = @intersect
export except = @except
export asc = @asc
export desc = @desc
export count_distinct = @count_distinct
export count_where = @count_where
export sum_where = @sum_where
export avg_where = @avg_where
export min_where = @min_where
export max_where = @max_where
export count = @count
export sum = @sum
export avg = @avg
export min = @min
export max = @max
export list = @list
export group = @group
export merge = @merge
export exists = @exists
export scalar = @scalar
export not = @not
export in_query = @in_query
export is_in = @is_in
export like = @like
export upper = @upper
export lower = @lower
export length = @length
export abs = @abs
export coalesce = @coalesce
export date = @date
export timestamp = @timestamp
export current_date = @current_date
export current_timestamp = @current_timestamp
export extract = @extract
export year = @year
export month = @month
export day = @day
export day_of_week = @day_of_week
export hour = @hour
export minute = @minute
