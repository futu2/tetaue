# A project using libraries as ordinary relative-path modules.
#
# There is no manifest and no package layer: `import` resolves relative to
# THIS file. `./vendor/acme` resolves to `./vendor/acme/index.tetaue`, an
# index module that aggregates the library with re-exports:
#
#   import "./vendor/acme"                    flat: users, orders, user_summaries, adult
#   import "./vendor/acme/predicates" as p    namespaced: p.adult
#   import "./vendor/shared/columns" (compact)  selective: just compact
#
# Hover `p.adult`, `compact`, or `users` to see the doc comments from the
# lib files; Ctrl+click jumps to them.

import "./vendor/acme"
import "./vendor/acme/predicates" as p
import "./vendor/shared/columns" (compact)

# adult_users: adults, compacted with the shared projection.
adult_users = users
    & filter p.adult
    & map compact
    & take 10

# spending: per-user order totals from the vendored acme tables.
spending = users
    & joinInner orders (l => r => l.id == r.user_id) (l => r => {
        user_id = r.user_id,
        name = l.name,
        total = r.total,
    })
    & fold (o => {
        user_id = group o.user_id,
        name = group o.name,
        spent = sum o.total,
    })
    & sort (r => [desc r.spent])
    & take 5

# adult_users is this module's query.
main = adult_users
