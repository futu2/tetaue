# The pure `list.*` namespace — Haskell base List vocabulary for in-memory
# lists, kept OUT of the unqualified (relational/SQL) namespace so the two
# never collide:
#
#   list.map / list.filter / list.fold / list.foldr   higher-order folds
#   list.sum / list.product / list.length             numeric/structural
#   list.reverse / list.concat / list.append          reshaping
#   list.take / list.drop / list.head / list.last     indexing
#   list.elem / list.isEmpty                          predicates
#
# A qualified name is not an Atom, so calling one needs parens — the same
# rule as `filter (p.adult)`:
#
#   (list.fold) (acc => x => acc + x) 0 [1, 2, 3]
#
# These are pure in-memory operations: they never touch SQL. `map`, `filter`,
# `take`, `drop`, `fold`, `sum`, `length`, `reverse`, `concat` keep their
# relational/SQL meanings unqualified.

# A module-level pure binding: total = 6.
total = (list.fold) (acc => x => acc + x) 0 [1, 2, 3]

# Doubling with list.map; the result is the list [2, 4, 6].
doubled = (list.map) (x => x * 2) [1, 2, 3]

# list.elem and list.isEmpty are predicates over the in-memory list.
has_four = (list.elem) 4 doubled
empty_check = (list.isEmpty) []

# list.* is in-memory only; use it to build a column value in a projection.
users: query { id: int, name: string } = table "users"
main = users
    & take 2
    & map (u => { id = u.id, total = total, has_four = has_four })
