# tetaue — the classic "adults" query, written with the optics core.
#
# A module is a list of bindings; the LAST binding is the module's query.
# Bindings need no terminator — `table "users" { ... }` is table applied to
# two arguments, and the next binding starts right after the closing brace.
#
# The optics keep the single-focus steps lambda-free:
#   mapped <<< name %~ upper            — transform a column across rows
# Predicates and ordering keep their row lambda (as in Haskell's `filtered`).

users = table "users" {
    id = int,
    name = string,
    age = int,
    active = bool,
}

adults = users
    & filtered (u => u.active && u ^. age >= 18)
    & mapped <<< name %~ upper
    & sort (u => [asc u.name])
    & take 10
