# tetaue — the classic "adults" query, teta-README style.
#
# A module is a list of bindings; the LAST binding is the module's query.
# Bindings need no terminator — `table "users" { ... }` is table applied to
# two arguments, and the next binding starts right after the closing brace.

users = table "users" {
    id = int,
    name = string,
    age = int,
    active = bool,
}

adults = users
    & filter (u => u.active && u.age >= 18)
    & map (u => { id = u.id, name = u.name })
    & sort (u => [asc u.name])
    & take 10
