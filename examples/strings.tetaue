# String and null handling.
#
# `map` projects one record per row — here the `email` column is lowered in
# place while computed columns (contact, email_upper, email_len) are added.
#
# Nullable columns are written explicitly with Haskell-style `(maybe T)`.
# There is no implicit `T` -> `(maybe T)` conversion: `null` has type
# `forall a. (maybe a)`, and it only unifies with other maybe values.
#
#   is_nothing u.nickname         → nickname IS NULL
#   from_maybe "" u.nickname      → COALESCE(nickname, '')
#   coalesce u.nickname u.email   → COALESCE(nickname, email)

users: query {
    id: int,
    email: (maybe string),
    nickname: (maybe string),
    last_seen: timestamp,
} = table "users"

active = (users
    & filter (u => is_just u.email && is_nothing u.nickname)
    & map (u => {
        id = u.id,
        email = lower (from_maybe "" u.email),
        contact = coalesce u.nickname u.email,
        email_upper = upper (from_maybe "" u.email),
        email_len = length (from_maybe "" u.email),
    })
    & distinct) : query {
        id: int,
        email: string,
        contact: (maybe string),
        email_upper: string,
        email_len: int,
    }

# active is this module's query.
main = active
