# String and null handling.
#
# `map` projects one record per row — here the `email` column is lowered in
# place while computed columns (contact, email_upper, email_len) are added.
#
# `== null` renders as IS NULL; `!= null` renders as IS NOT NULL.
#
# NULL is the Maybe-style nullable type `t?` ("t or NULL"): `null` has type
# `forall a. a?`, and comparing with null is always well-typed. Nullable
# columns are written explicitly (`email: string?`). Nullable values flow
# through expressions the same way: `length u.email: int?`,
# `coalesce u.nickname u.email: string?`.

# `nickname` is the nullable column (`string?`): `u.nickname == null` and
# `coalesce u.nickname u.email` both make sense because it may be NULL.
users: query {
    id: int,
    email: string,
    nickname: string?,
    last_seen: timestamp,
} = table "users"

active = (users
    & filter (u => u.email != null && u.nickname == null)
    & map (u => {
        id = u.id,
        email = lower u.email,
        contact = coalesce u.nickname u.email,
        email_upper = upper u.email,
        email_len = length u.email,
    })
    & distinct) : query {
        id: int,
        email: string,
        contact: string?,
        email_upper: string,
        email_len: int,
    }
