# String and null handling, in the optics style.
#
# `mapped <<< email %~ lower` is `over` the composed optic `mapped <<< email`:
# for every row, view the `email` lens, apply lower, set it back — one column
# transformed while the other columns pass through.
#
# `== null` renders as IS NULL; `!= null` renders as IS NOT NULL.

users = table "users" {
    id = int,
    email = string,
    nickname = string,
    last_seen = timestamp,
}

active = users
    & filtered (u => u.email != null && u.nickname == null)
    & mapped <<< email %~ lower
    & mapped %~ (u => {
        id = u.id,
        contact = coalesce u.nickname u.email,
        email_upper = upper u.email,
        email_len = length u.email,
    })
    & distinct
