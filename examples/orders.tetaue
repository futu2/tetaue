# Aggregation with fold and a join, in the optics style.
#
# fold is the aggregate projection: every entry is either group (a GROUP BY
# key) or an aggregate (count, sum, avg, min, max). `filtered` selects rows
# before the join; `mapped %~` projects a record per row.

users = table "users" {
    id = int,
    name = string,
}

orders = table "orders" {
    id = int,
    user_id = int,
    total = float,
    status = string,
}

paid = orders & filtered (o => o.status == "paid")

# Rename the colliding "id" column on the left side before joining:
user_rows = users & mapped %~ (u => { uid = u.id, name = u.name })

by_user = user_rows
    & join paid ($1.uid == $2.user_id) "inner"
    & fold (o => {
        user_id = group o.user_id,
        name = group o.name,
        order_count = count o.id,
        total_spent = sum o.total,
        avg_order = avg o.total,
    })
    & sort (r => [desc r.total_spent])
    & take 20
