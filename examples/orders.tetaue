# Aggregation with fold and a join.
#
# fold is the aggregate projection: every entry is either group (a GROUP BY
# key) or an aggregate (count, sum, avg, min, max). `filter` selects rows
# before the join; a fixed-kind join function merges two tables.
#
# joinInner takes three positional arguments: the right-hand query and the
# two-argument (curried) `on` and `merger` functions that project the result row.
# Use joinLeft, joinRight, or joinFull for an outer join:
#   joinInner paid (l => r => l.id == r.user_id) (l => r => { user_id = r.user_id, ... })
# The merger replaces the old disjoint-union of both rows: the result row is
# exactly what it projects, so colliding column names are fine.
#
# Numbers are strict: `total: float` means comparisons and arithmetic need
# float literals (`o.total >= 100.0`, never `100`). Annotations can also be
# written on lambda parameters: `(o: { status: string | r }) => ...` checks
# the body against the signature, and the tail `r` absorbs the other columns
# when the step is applied.

users: query {
    id: int,
    name: string,
} = table "users"

orders: query {
    id: int,
    user_id: int,
    total: float,
    status: string,
} = table "orders"

# An annotated lambda parameter: the row has at least `status: string`.
paid = orders & filter (o: {status: string | r }) => o.status == "paid"

by_user = users
    & joinInner paid (l => r => l.id == r.user_id) (l => r => {
        user_id = r.user_id,
        name = l.name,
        order_id = r.id,
        total = r.total,
    })
    & fold (o => {
        user_id = group o.user_id,
        name = group o.name,
        order_count = count o.order_id,
        total_spent = sum o.total,
        avg_order = avg o.total,
    })
    & sort (r => [desc r.total_spent])
    & take 20

# by_user is this module's query.
main = by_user
