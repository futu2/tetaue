# Shared table definitions — import this file to get `users` and `orders`.
#
# The query type annotation is the schema: `id: int` is a non-null int
# column; write `id: (maybe int)` for a nullable one — see examples/strings.tetaue.
#
# Only `export`ed bindings are visible to importers — everything else is
# module-private. `import "tables.tetaue"` brings the exported bindings into
# scope; `import "tables.tetaue" as t` reaches them qualified as `t.users`.
#
# The `main` binding makes this file a runnable example too: `tetaue render
# tables.tetaue` shows the users table. Importers never see `main` (it is not
# exported), so it stays a shared module for the other examples.

export users: query {
    id: int,
    name: string,
    age: int,
    active: bool,
} = table "users"

export orders: query {
    id: int,
    user_id: int,
    total: float,
    status: string,
} = table "orders"

# users is this module's query.
main = users
